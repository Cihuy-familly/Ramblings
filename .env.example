# =============================================================================
# Blog Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your deployment.
#   cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL) ---
# Postgres password (required)
DB_PASSWORD=blogpassword
# Postgres database name (default: blog)
POSTGRES_DB=blog
# Postgres user (default: blog)
POSTGRES_USER=blog
# Published port for Postgres (default: 5432)
POSTGRES_PORT=5432
# Custom directory for Postgres data (default: ./data/postgres)
POSTGRES_DATA_DIR=./data/postgres

# --- Redis ---
# Published port for Redis (default: 6379)
REDIS_PORT=6379

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Published API port (default: 9000)
MINIO_API_PORT=9000
# Published console port (default: 9001)
MINIO_CONSOLE_PORT=9001
# MinIO bucket name (default: blog-images)
MINIO_BUCKET=blog-images
# Use SSL for MinIO (default: false)
MINIO_USE_SSL=false
# Custom directory for MinIO data (default: ./data/minio)
MINIO_DATA_DIR=./data/minio

# --- Meilisearch (Full-text search) ---
MEILI_MASTER_KEY=dev-meili-key
# Published port (default: 7700)
MEILI_PORT=7700
# Custom directory for Meilisearch data (default: ./data/meilisearch)
MEILI_DATA_DIR=./data/meilisearch

# --- JWT ---
# Secret key for signing JWT tokens (CHANGE THIS IN PRODUCTION)
JWT_SECRET=dev-secret-change-in-production

# --- Backend ---
# Backend server port inside the container (default: 8080)
# The published port is managed by the frontend nginx proxy
SERVER_PORT=8080

# --- Frontend ---
# Published port for the frontend (default: 80)
# For local dev without Docker, the Vite dev server runs on port 5173
FRONTEND_PORT=80
# Optional port suffix appended to FRONTEND_URL and GOOGLE_CALLBACK_URL
# e.g., set to ":8080" if frontend is behind a reverse proxy on a non-standard port
FRONTEND_PORT_SUFFIX=

# --- Docker Images ---
# Override these to use custom image names/tags
# BACKEND_IMAGE=registry.cihuyproject.my.id/blog-backend:latest
# FRONTEND_IMAGE=registry.cihuyproject.my.id/blog-frontend:latest

# --- Google OAuth (required for social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full callback URL (default: http://localhost/api/v1/auth/google/callback)
# Uses FRONTEND_PORT_SUFFIX if set (e.g., http://localhost:8080/api/v1/auth/google/callback)
GOOGLE_CALLBACK_URL=http://localhost/api/v1/auth/google/callback
# Frontend URL for CORS (default: http://localhost)
# Uses FRONTEND_PORT_SUFFIX if set (e.g., http://localhost:8080)
FRONTEND_URL=http://localhost
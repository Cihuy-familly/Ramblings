FROM golang:1.27-alpine

RUN apk --no-cache add ca-certificates tzdata git

# Install air for hot reload
RUN go install github.com/air-verse/air@latest

WORKDIR /app

# Pre-cache dependencies (source code is mounted at runtime)
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]